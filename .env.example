# Copy this file to .env and fill it in. The .env file is never committed.
#
# You do not need any of this for `npm run dev:local`, which starts its own
# local database. You do need it for `npm run dev`, `npm start` and hosting.

# MongoDB connection string, e.g. from MongoDB Atlas (Database > Connect > Drivers).
# Put the database name (marktplatz) before the question mark.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/marktplatz?retryWrites=true&w=majority

# A long random string that signs the organiser's session cookie.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# The organiser account that `npm run seed` creates.
# These are the demonstration values used when the variables are not set.
ADMIN_EMAIL=organiser@marktplatz.example
ADMIN_PASSWORD=Abbey-Close-Chalets-27

# Optional: cookieless visit statistics with Umami. Leave empty to switch off.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
